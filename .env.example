# POLAR SENSE AI — Environment Configuration (SIH26063)

# AI Provider Configuration ('demo' | 'gemini' | 'openai')
# Default is 'demo', which works 100% offline with zero external API dependencies for hackathon reliability.
AI_PROVIDER=demo

# Google Gemini API Key (Server-side only)
GEMINI_API_KEY=

# OpenAI API Key (Server-side only)
OPENAI_API_KEY=

# Application Mode ('demo' | 'production')
APP_MODE=demo

# Server Port
PORT=3000
